TEMPLATE = app
TARGET = antzium
INCLUDEPATH += .

QT += widgets

# libqtrsound is developed next to AntSim. Its qmake project doubles as an
# embeddable source module, so AntSim and the library always use the same API.
isEmpty(QTRSNDPATH) {
    QTRSNDPATH = $$clean_path($$PWD/../../libqtrsound/libqtrsound)
}
!exists($$QTRSNDPATH/qtrsnd.h) {
    error("libqtrsound was not found at $$QTRSNDPATH")
}
CONFIG += with_sdl2
include($$QTRSNDPATH/libqtrsound.pro)
CONFIG -= c++11
CONFIG += c++17

